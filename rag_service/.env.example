# Token Harbor gateway (OpenAI-compatible) for the RAG generator.
# Get a key at https://tokenharbor.ai/dashboard/api-keys
TOKENHARBOR_API_KEY=

# Optional overrides. Defaults already point at the locked experiment model.
# GENERATOR_MODEL=deepseek-v4.1-flash:free
# GENERATOR_BASE_URL=https://tokenharbor.ai/v1
# GENERATOR_TEMPERATURE=0.0
# GENERATOR_MAX_OUTPUT_TOKENS=600
# GENERATOR_SEED=

# ---------------------------------------------------------------------------
# RAGAS evaluator judge (Task 4.2)
# ---------------------------------------------------------------------------
# The judge MUST belong to a different model family than the generator
# (PRD section 8.4 / docs/decisions/2026-11-21-ragas-judge-model.md) or the
# JudgeClient refuses to start. Point these at any OpenAI-compatible endpoint.
#
# Default: MiMo on Token Harbor (the only free non-DeepSeek route available).
JUDGE_MODEL=mimo-v2.6-flash:free
JUDGE_BASE_URL=https://tokenharbor.ai/v1
# Name of the env var that holds the key (not the key itself).
JUDGE_API_KEY_ENV=TOKENHARBOR_API_KEY
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_OUTPUT_TOKENS=700
#
# Example: switch to Google's OpenAI-compatible endpoint
# JUDGE_MODEL=gemini-3.8-flash
# JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# JUDGE_API_KEY_ENV=GEMINI_API_KEY
